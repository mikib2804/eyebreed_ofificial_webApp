# Database (server-only)
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require

# Authentication
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_GOOGLE_ID=REPLACE_ME.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=REPLACE_ME
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://eyebreedofficial.com

# Stripe test mode for the pre-release deployment
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CHECKOUT_ENABLED=false

# Transactional email
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=EYEBREED <account@eyebreedofficial.com>

# Media/integration allowlists
MEDIA_ALLOWED_HOSTS=images.unsplash.com
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v24.0
