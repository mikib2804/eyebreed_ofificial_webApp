# Primary PostgreSQL database. Keep both values server-only.
DATABASE_URL=
DIRECT_URL=

# Auth.js. Generate a long random AUTH_SECRET and configure Google OAuth for
# each deployed domain's /api/auth/callback/google URL.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test mode. Use only sk_test_/pk_test_ credentials until the final
# production review. The webhook secret comes from Stripe CLI/Dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ENABLED=false

# Transactional email (optional until email delivery is enabled).
RESEND_API_KEY=
EMAIL_FROM=EYEBREED <account@example.com>

# Instagram Graph API credentials. These are server-only and must never use NEXT_PUBLIC_ prefixes.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v24.0
