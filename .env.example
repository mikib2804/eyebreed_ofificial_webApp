# Primary PostgreSQL database. Keep both values server-only.
DATABASE_URL=
DIRECT_URL=

# Read-only legacy PostgreSQL source used only by the dry-run/import command.
# Never point this at the primary database or commit a real value.
LEGACY_DATABASE_URL=
LEGACY_SOURCE_NAME=Eyebreed_Db
LEGACY_SOURCE_SCHEMA=public
LEGACY_SOURCE_TABLE=parameter_ordinal_position
LEGACY_IMPORT_BACKUP_CONFIRMED=false

# Auth.js. Generate a long random AUTH_SECRET and configure Google OAuth for
# each deployed domain's /api/auth/callback/google URL.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
MEDIA_ALLOWED_HOSTS=images.unsplash.com

# Stripe test mode. Use only sk_test_/pk_test_ credentials until the final
# production review. The webhook secret comes from Stripe CLI/Dashboard.
# Safe placeholders only. Replace them in the hosting provider; never commit
# usable credentials. The secret and webhook values must remain server-only.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CHECKOUT_ENABLED=false

# Transactional email. Use a verified Resend sender/domain in production.
RESEND_API_KEY=
EMAIL_FROM=EYEBREED <account@example.com>

# Instagram Graph API credentials. These are server-only and must never use NEXT_PUBLIC_ prefixes.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v24.0
