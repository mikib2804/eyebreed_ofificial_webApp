generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShippingStatus {
  NOT_SHIPPED
  READY
  SHIPPED
  DELIVERED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  STORE
  PRODUCT
  CATEGORY
}

enum PreOrderStatus {
  WAITING
  PRODUCT_AVAILABLE
  CUSTOMER_NOTIFIED
  CONVERTED_TO_ORDER
  CANCELLED
}

enum MessageStatus {
  NEW
  READ
  IN_PROGRESS
  REPLIED
  DECLINED
  ARCHIVED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          Role       @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  cartItems     CartItem[]
  orders        Order[]
  addresses     Address[]
  wishlist      WishlistItem[]
  preOrders     PreOrder[]
  passwordResetTokens PasswordResetToken[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  postalCode String?
  country    String   @default("Israel")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  nameHe      String?
  slug        String     @unique
  description String?
  products    Product[]
  discounts   Discount[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                   String                @id @default(cuid())
  name                 String
  nameHe               String?
  slug                 String                @unique
  description          String                @db.Text
  descriptionHe        String?               @db.Text
  story                String?               @db.Text
  storyHe              String?               @db.Text
  priceUsd             Decimal               @db.Decimal(10, 2)
  priceIls             Decimal               @db.Decimal(10, 2)
  priceEur             Decimal               @db.Decimal(10, 2)
  inventory            Int                   @default(0)
  images               String[]
  videoUrl             String?
  material             String?
  status               ProductStatus         @default(DRAFT)
  featured             Boolean               @default(false)
  bestSeller           Boolean               @default(false)
  isNew                Boolean               @default(false)
  lowStockThreshold    Int                   @default(5)
  categoryId           String
  category             Category              @relation(fields: [categoryId], references: [id])
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  variants             ProductVariant[]
  orderItems           OrderItem[]
  discounts            Discount[]
  preOrders            PreOrder[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([categoryId, status])
  @@index([featured])
}

model ProductVariant {
  id        String   @id @default(cuid())
  size      String
  color     String   @default("")
  inventory Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  size      String?
  color     String?
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size, color])
  @@index([userId])
  @@index([productId])
}

model VisionWaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  locale    String        @default("he")
  ipHash    String
  status    MessageStatus @default(NEW)
  replyBody String?       @db.Text
  repliedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String
  shippingAddress  Json
  total            Decimal        @db.Decimal(10, 2)
  currency         String         @default("ILS")
  status           OrderStatus    @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus  @default(PENDING)
  shippingStatus   ShippingStatus @default(NOT_SHIPPED)
  trackingNumber   String?
  shippingProvider String?
  items            OrderItem[]
  history          OrderHistory[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model OrderHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Discount {
  id               String        @id @default(cuid())
  name             String
  code             String?       @unique
  type             DiscountType
  scope            DiscountScope @default(STORE)
  value            Decimal       @db.Decimal(10, 2)
  active           Boolean       @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  minimumPurchase  Decimal?      @db.Decimal(10, 2)
  usageLimit       Int?
  perCustomerLimit Int?
  usageCount       Int           @default(0)
  products         Product[]
  categories       Category[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([active, startsAt, endsAt])
}

model PreOrder {
  id           String         @id @default(cuid())
  customerName String
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  phone        String?
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size         String?
  color        String?
  quantity     Int            @default(1)
  status       PreOrderStatus @default(WAITING)
  contactedAt  DateTime?
  notifiedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([email, productId, size, color])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model EmailNotification {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  recipient String
  template  String
  sentAt    DateTime @default(now())

  @@index([recipient, sentAt])
}

model InventoryAdjustment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  delta     Int
  reason    String
  actorId   String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model StoreSettings {
  id                       String   @id @default("store")
  contactEmail             String?
  contactPhone             String?
  shippingInfo             String?  @db.Text
  defaultLowStockThreshold Int      @default(5)
  announcement             String?
  announcementActive       Boolean  @default(false)
  notificationPreferences  Json?
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
