{
  "name": "vero-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/accessibility.test.ts tests/bit-whatsapp.test.ts tests/discount-conditions.test.ts tests/pre-order-content.test.ts tests/palettes.test.ts tests/site-routes.test.ts tests/request-security.test.ts tests/pricing.test.ts tests/product-reference.test.ts tests/cart-promotion.test.ts tests/address-validation.test.ts tests/admin-product-validation.test.ts",
    "check": "npm run typecheck && npm test",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:inventory": "tsx scripts/db-inventory.ts",
    "db:inspect-legacy": "tsx scripts/inspect-legacy-source.ts",
    "db:import-legacy": "tsx scripts/import-legacy-parameter-ordinal-position.ts",
    "db:normalize-legacy-waitlist": "tsx scripts/normalize-legacy-waitlist.ts",
    "test:quote": "tsx scripts/smoke-cart-quote.ts",
    "test:auth": "tsx scripts/smoke-auth.ts",
    "check:deploy": "tsx scripts/check-deploy-readiness.ts",
    "admin:role": "tsx scripts/set-admin-role.ts",
    "account:link-records": "tsx scripts/link-verified-customer-records.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.4.49",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
